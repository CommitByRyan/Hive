# Hive configuration example.
# Copy this file to .env in the Hive installation directory and edit values.
# Process environment variables override .env values.
# Never commit a real .env or API key.

# OpenAI-compatible API base URL.
HIVE_BASE_URL=https://api.openai.com/v1

# API key. Leave blank for demo mode.
HIVE_API_KEY=

# Model name. Leave blank for demo mode.
HIVE_MODEL=

# HTTP listen address. Keep loopback unless you add an authenticated proxy.
HIVE_HOST=127.0.0.1
HIVE_PORT=8765

# Maximum number of nodes executed in parallel.
HIVE_MAX_PARALLEL=2

# Set to 1 to enable shell tools (still approval-gated).
HIVE_ALLOW_SHELL=0

# Relative paths are resolved against the installation directory.
HIVE_DATA_DIR=data
HIVE_SANDBOX_DIR=sandbox
